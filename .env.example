# Copy to .env.local for local development. Never commit real values (.env* is gitignored).
# Deployed values go in the Vercel project's environment variables (Production / Preview).
# Variables are documented in docs/architecture.md → "Configuration". Most are unused until the
# phase noted in brackets; leave them empty until then.

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, sitemap and email links. Defaults to http://localhost:3000.
# On Vercel, set it to the production domain in the Production environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase [phase 2] ────────────────────────────────────────────────────────
# Locally: `npm run db:start && npm run db:env` fills these three in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — bypasses RLS. Allowed uses are listed in docs/roles.md. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Email: Resend [phase 2/8] ─────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="ACF <no-reply@example.org>"

# ── Discord [phase 8] ─────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_WEBHOOK_URL_ANNOUNCEMENTS=
DISCORD_WEBHOOK_URL_EVENTS=

# ── Scheduled jobs [phase 8] ──────────────────────────────────────────────────
# Shared with GitHub Actions (repository secret) to authenticate POST /api/cron/*.
CRON_SECRET=

# ── E-signature [phase 6/8] ───────────────────────────────────────────────────
# manual | documenso | docuseal
SIGNATURE_PROVIDER=manual
SIGNATURE_API_URL=
SIGNATURE_API_KEY=
SIGNATURE_WEBHOOK_SECRET=

# ── Bot protection: Cloudflare Turnstile [phase 2] ────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Backups [phase 8] — GitHub secret, listed here for completeness ───────────
BACKUP_AGE_RECIPIENT=

# ── Developer tooling (your machine / Claude environment, not the app) ────────
# Supabase MCP server, dev project only (scripts/mcp/supabase-dev.sh).
SUPABASE_ACCESS_TOKEN=
SUPABASE_DEV_PROJECT_REF=
# Show the hidden areas in `npm run dev` without auth (development only; ignored in builds).
ACF_PREVIEW_HIDDEN_AREAS=
# Use a pre-installed Chromium for Playwright (set automatically in Claude Code cloud sessions).
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Mailpit API used by the auth e2e tests (defaults to the local stack, http://127.0.0.1:54324).
MAILPIT_URL=
